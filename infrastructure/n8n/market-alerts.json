{
    "name": "Market Alert Workflow",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "seconds",
                            "secondsInterval": 30
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "Every 30 Seconds",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$env.ORDERFLOW_SERVICE_URL}}/metrics"
            },
            "id": "get-metrics",
            "name": "Get Confirmation Metrics",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                470,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ $json.rejected }}",
                            "operation": "largerEqual",
                            "value2": 5
                        }
                    ]
                }
            },
            "id": "check-rejections",
            "name": "High Rejections?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                690,
                300
            ]
        },
        {
            "parameters": {
                "channel": "#trading-alerts",
                "text": ":warning: High Rejection Rate Alert!\nTotal Requests: {{ $json.total_requests }}\nApproved: {{ $json.approved }}\nRejected: {{ $json.rejected }}\n\nTop Rejection Reasons:\n{{ Object.entries($json.rejection_reasons).map(([k, v]) => `• ${k}: ${v}`).join('\\n') }}",
                "attachments": []
            },
            "id": "alert-high-rejections",
            "name": "Alert High Rejections",
            "type": "n8n-nodes-base.slack",
            "typeVersion": 2,
            "position": [
                910,
                200
            ],
            "credentials": {
                "slackApi": {
                    "id": "{{$env.SLACK_CREDENTIAL_ID}}",
                    "name": "Slack"
                }
            }
        },
        {
            "parameters": {},
            "id": "no-op",
            "name": "No Action",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                910,
                400
            ]
        }
    ],
    "connections": {
        "Every 30 Seconds": {
            "main": [
                [
                    {
                        "node": "Get Confirmation Metrics",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Confirmation Metrics": {
            "main": [
                [
                    {
                        "node": "High Rejections?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "High Rejections?": {
            "main": [
                [
                    {
                        "node": "Alert High Rejections",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "No Action",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "tags": [
        "monitoring",
        "alerts"
    ],
    "triggerCount": 0
}