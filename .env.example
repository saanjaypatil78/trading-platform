# =================================
# Environment Configuration
# =================================
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PYTHON_ENV=development
APP_NAME=TradingPlatform
APP_VERSION=1.0.0
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/trading_platform

# TimescaleDB (uses same PostgreSQL instance)
TIMESCALEDB_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys - Market Data Providers
# RapidAPI
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=indian-stock-exchange.p.rapidapi.com

# Finnhub
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage (optional fallback)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Yahoo Finance (no key needed, but rate limited)
YAHOO_FINANCE_ENABLED=true

# Alpaca (US Broker)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_PAPER=true

# Polygon.io (Institutional Data)
POLYGON_API_KEY=your_polygon_key_here

# Broker API Keys (for live trading)
# Zerodha Kite
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/callback/zerodha

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://localhost:3000/callback/upstox

# Angel One
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@tradingplatform.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Monitoring & Logging
SENTRY_DSN=
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Caching Configuration
CACHE_DEFAULT_TTL=300
CACHE_QUOTES_TTL=60
CACHE_OHLC_TTL=60
CACHE_HISTORICAL_TTL=86400
CACHE_FUNDAMENTALS_TTL=604800

# Scanner Configuration
SCANNER_MAX_STOCKS=10000
SCANNER_PARALLEL_WORKERS=4
SCANNER_TIMEOUT_SECONDS=300

# Backtesting Configuration
BACKTEST_MAX_YEARS=10
BACKTEST_DEFAULT_CAPITAL=100000
BACKTEST_COMMISSION_PERCENT=0.05

# Paper Trading Configuration
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_TRADING_SLIPPAGE_PERCENT=0.1

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Session
SESSION_SECRET=your_session_secret_key_change_this
